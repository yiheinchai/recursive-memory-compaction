{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rmc hook user-prompt-submit",
            "timeout": 10,
            "_rmc": true,
            "statusMessage": "Recalling lessons\u2026"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rmc hook session-end",
            "timeout": 15,
            "_rmc": true,
            "statusMessage": "Learning from this session\u2026"
          }
        ]
      }
    ]
  }
}
